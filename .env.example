# Credential the gateway uses to authenticate to OpenRouter. Server-side only.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Credential downstream clients must present to call /invoke.
# Generate your own, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
GATEWAY_API_KEY=your-gateway-key-here
